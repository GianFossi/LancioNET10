digraph G {
  graph [rankdir=TB, bgcolor="transparent", pad=0.2];
  node [shape=box, style="rounded,filled", fillcolor="#eef5ff", color="#315b8a", fontname="Arial", fontsize=10];
  edge [color="#52677d", fontname="Arial", fontsize=9];
  coords [label="CoorInMem\nEnumera entrambe le corone\nsettore → fila → posizione"];
  inner [label="Scansione di tutti gli interni liberi\nSceglie r = sqrt(x²+y²) massimo"];
  candidates [label="Scansione di tutti gli esterni liberi\nCalcola d, Δθ e J = d·(1+Fact·Δθ/2π)"];
  choose [label="Ordina: estrae il J positivo minimo\ne ne cambia il segno"];
  fly [label="Sorvolo: un foro libero è dentro il segmento\ne a distanza < dtubo−Interf?", shape=diamond, fillcolor="#fff7d6"];
  cross [label="VerifInters: il segmento attraversa\nla zona circolare centrale?", shape=diamond, fillcolor="#fff7d6"];
  bind [label="Registra Accoppia, IndT1, IndT2"];
  done [label="Tutti i fori accoppiati?", shape=diamond, fillcolor="#fff7d6"];
  back [label="Backtracking\nlibera coppie precedenti e riprova\noppure riduce Fact di 0,25"];
  fail [label="Richiede riequilibrio manuale", fillcolor="#fee2e2"];
  out [label="Scrive file .COO", fillcolor="#e6f7ee"];
  coords -> inner -> candidates -> choose -> fly;
  fly -> choose [label="sì"];
  fly -> cross [label="no"];
  cross -> choose [label="no"];
  cross -> bind [label="sì"];
  bind -> done;
  done -> inner [label="no"];
  done -> out [label="sì"];
  choose -> back [label="nessun candidato"];
  back -> inner [label="alternativa trovata"];
  back -> fail [label="nessuna soluzione"];
}
