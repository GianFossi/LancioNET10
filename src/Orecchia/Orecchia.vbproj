<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>Orecchia</AssemblyName>
    <RootNamespace>Orecchia</RootNamespace>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <CodePage>1252</CodePage>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <MigrationDependencyDirectory Condition="'$(MigrationDependencyDirectory)' == ''">$(MSBuildProjectDirectory)/../../local/dependencies</MigrationDependencyDirectory>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LibMat/LibMat.vbproj" />
    <Reference Include="RoutBase1">
      <HintPath>$(MigrationDependencyDirectory)/RoutBase1.dll</HintPath>
    </Reference>
    <EmbeddedResource Include="InserDati_1.resX" />
    <EmbeddedResource Include="InserDati_2.resX" />
    <EmbeddedResource Include="InserDati_3.resX" />
    <None Update="Arch/**/*;Aiuto/**/*" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
  </ItemGroup>
  <Target Name="CheckMigrationDependencies" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(MigrationDependencyDirectory)/RoutBase1.dll')"
           Text="Orecchia requires the migrated RoutBase1 assembly; set MigrationDependencyDirectory. The imported Orecchia module and clsMonitor definitions are also missing. Do not substitute empty calculation stubs." />
  </Target>
</Project>
