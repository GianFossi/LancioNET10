  3. STRESS COMPONENTS\par
                                                           ** SECTIONS **\par
                                                            A-A     B-B\par
    Actual Nozzle Thk. e  =                    \     \ ######.## #####.##_\par
    Mean Nozzle Diam.  d{_\sub m} =                    \     \ ######.## #####.##_\par
    {\b Pressure Loads}\par
    Circum. Stress     {{_\field{_\*_\fldinst SYMBOL 115 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}{_\sub {_\field{_\*_\fldinst SYMBOL 106 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}} =   p{_\sub o}*r{_\sub i}/e          \     \ ######.## #####.##_\par
    Longit. Stress     {{_\field{_\*_\fldinst SYMBOL 115 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}{_\sub z} =   p{_\sub o}*r{_\sub i}{_\super 2}/(d{_\sub m}*e)    \     \ ######.## #####.##_\par
    Radial  Stress     {{_\field{_\*_\fldinst SYMBOL 115 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}{_\sub R} = -0.5p{_\sub o}            \     \ ######.## #####.##_\par
    Circum. Stress     {{_\field{_\*_\fldinst SYMBOL 115 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}{_\sub {_\field{_\*_\fldinst SYMBOL 106 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}} =   p{_\sub o}*r{_\sub o}/e          \     \ ######.## #####.##_\par
    Longit. Stress     {{_\field{_\*_\fldinst SYMBOL 115 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}{_\sub z}=   p{_\sub o}*r{_\sub o}{_\super 2}/(d{_\sub m}*e)    \     \ ######.## #####.##_\par
    Radial  Stress     {{_\field{_\*_\fldinst SYMBOL 115 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}{_\sub R}= + 0.5p{_\sub o}            \     \ ######.## #####.##_\par
    {\b Dead Loads}\par
    Longit. Stress     {{_\field{_\*_\fldinst SYMBOL 115 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}{_\sub z} =   P/({{_\field{_\*_\fldinst SYMBOL 112 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f3_\fs18}}}*d{_\sub m}*e)       \     \ ######.## #####.##_\par
    Longit. Stress     {{_\field{_\*_\fldinst SYMBOL 115 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}{_\sub z} = {{_\field{_\*_\fldinst SYMBOL 177 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f3_\fs18}}} 4*M/({{_\field{_\*_\fldinst SYMBOL 112 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f3_\fs18}}}*d{_\sub m}{_\super 2}*e)    \     \ ######.## #####.##_\par
    Shear   Stress     {{_\field{_\*_\fldinst SYMBOL 116 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}  =   2*M{_\sub T}/({{_\field{_\*_\fldinst SYMBOL 112 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f3_\fs18}}}*d{_\sub m}{_\super 2}*e)   \     \ ######.## #####.##_\par
    Shear   Stress     {{_\field{_\*_\fldinst SYMBOL 116 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f1_\fs18}}}  =   1.885*V/({{_\field{_\*_\fldinst SYMBOL 112 _\_\f "Symbol" _\_\s 9}{_\fldrslt_\f3_\fs18}}}*d{_\sub m}*e) \     \ ######.## #####.##_\par
    {\b Thermal Loads}\par
