<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <CodePage>1252</CodePage>
    <AssemblyName>Tiranti</AssemblyName>
    <RootNamespace>Tiranti</RootNamespace>
    <OutputType>Library</OutputType>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <DefineConstants>Win32 = True</DefineConstants>
    <RemoveIntegerChecks>false</RemoveIntegerChecks>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DefineConstants>Win32 = True</DefineConstants>
    <RemoveIntegerChecks>false</RemoveIntegerChecks>
    <Optimize>false</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.vb" />
    <Compile Include="frmcoef.vb" />
    <EmbeddedResource Include="frmcoef.resX" />
    <Compile Include="Serraggio.vb" />
    <Compile Include="Tir1.vb" />
    <EmbeddedResource Include="Tir1.resX" />
    <Compile Include="tirMonitor.vb" />
    <Compile Include="Vari.vb" />
    <Content Include="Arch/Tiranti.doc" />
    <Import Include="System.Collections" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Windows.Forms" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <ProjectReference Include="../RoutBase/RoutBase1.vbproj" />
    <ProjectReference Include="../LibMat/LibMat.vbproj" />
    <ProjectReference Include="../StubW2000/StubW2000.vbproj" />
    <Reference Include="stdole" />
    <Reference Include="Microsoft.VisualBasic.Compatibility" />
  </ItemGroup>
</Project>
