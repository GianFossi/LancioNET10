<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <AssemblyName>LibMat</AssemblyName>
    <RootNamespace>LibMat</RootNamespace>
    <OptionStrict>On</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
    <OptionCompare>Binary</OptionCompare>
    <CodePage>1252</CodePage>
    <DefineConstants>Win32=True</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Windows.Forms" />
    <PackageReference Include="System.Data.OleDb" Version="10.0.0" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <ProjectReference Include="../Lancio.Data.Access/Lancio.Data.Access.vbproj" />
    <None Update="Arch/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Import Project="LegacySources.props" />
  <ItemGroup>
    <Compile Include="../RoutBase/IndexedControls.vb" Link="Migration/IndexedControls.vb" />
    <Compile Include="LegacyMaterialMetadata.vb" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../RoutBase/RoutBase1.vbproj" />
    <ProjectReference Include="../RoutBase2/RoutBase2.vbproj" />
    <ProjectReference Include="../RoutBase3/RoutBase3.vbproj" />
    <ProjectReference Include="../RoutBase4/RoutBase4.vbproj" />
    <ProjectReference Include="../StubW2000/StubW2000.vbproj" />
    <ProjectReference Include="../StubW9/StubW9.vbproj" />
  </ItemGroup>
</Project>
