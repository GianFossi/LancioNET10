<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <CodePage>1252</CodePage>
    <AssemblyName>LancioHTRI</AssemblyName>
    <RootNamespace>LancioHTRI</RootNamespace>
    <OutputType>WinExe</OutputType>
    <PlatformTarget>x86</PlatformTarget>
    <RuntimeIdentifier>win-x86</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <StartupObject>Sub Main</StartupObject>
    <MyType>WindowsFormsWithCustomSubMain</MyType>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="clsMonitor.vb" />
    <Compile Include="mainLancioHTRI.vb" />
    <Compile Include="My Project/AssemblyInfo.vb" />
    <Compile Include="My Project/Application.Designer.vb">
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Include="My Project/Resources.Designer.vb">
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="My Project/Settings.Designer.vb">
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <EmbeddedResource Include="My Project/Resources.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <None Include="My Project/Application.myapp" />
    <None Include="My Project/Settings.settings" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Drawing" />
    <Import Include="System.Diagnostics" />
    <Import Include="System.Windows.Forms" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
    <ProjectReference Include="../Grafic2/Grafic2.vbproj" />
    <ProjectReference Include="../HTRI/HTRI.vbproj" />
    <ProjectReference Include="../LibMat/LibMat.vbproj" />
    <ProjectReference Include="../RoutBase/RoutBase1.vbproj" />
    <ProjectReference Include="../Ventil/Ventil.vbproj" />
  </ItemGroup>
  <ItemGroup><Compile Include="LegacyStartup.vb" /><ProjectReference Include="../Lancio.Legacy.Serialization/Lancio.Legacy.Serialization.vbproj" /></ItemGroup>
</Project>
