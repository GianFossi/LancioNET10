<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDefaultNoneItems>false</EnableDefaultNoneItems>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
    <CodePage>1252</CodePage>
    <AssemblyName>RoutBase3</AssemblyName>
    <RootNamespace>RoutBase3</RootNamespace>
    <OutputType>Library</OutputType>
    <MyType>Windows</MyType>
    <UseWindowsForms>true</UseWindowsForms>
    <OptionStrict>Off</OptionStrict>
    <OptionExplicit>On</OptionExplicit>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="clsAccessoDati.vb" />
    <Compile Include="My Project/AssemblyInfo.vb" />
    <Compile Include="My Project/Application.Designer.vb">
      <DependentUpon>Application.myapp</DependentUpon>
    </Compile>
    <Compile Include="My Project/Resources.Designer.vb">
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
    <Compile Include="My Project/Settings.Designer.vb">
      <DependentUpon>Settings.settings</DependentUpon>
    </Compile>
    <EmbeddedResource Include="My Project/Resources.resx">
      <SubType>Designer</SubType>
    </EmbeddedResource>
    <None Include="My Project/Application.myapp" />
    <None Include="My Project/Settings.settings" />
    <Import Include="System.Collections" />
    <Import Include="System.Collections.Generic" />
    <Import Include="System.Data" />
    <Import Include="System.Diagnostics" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
    <PackageReference Include="System.Configuration.ConfigurationManager" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Lancio.Data.Access/Lancio.Data.Access.vbproj" />
  </ItemGroup>
</Project>
