('\par \pard \s18\qj\widctlpar\tx5245 ',                                        1
'\par FLANGE MATERIAL\tab :',A24,/                                              1
'\par DESIGN TEMPERATURE (TEST TEMP.) [\''b0C]    T\tab =',F10.4,/              1
'\par DESIGN PRESSURE(TEST PRES.)    [MPa]    P\tab =',F10.3,/                  1
'\par FLANGE INSIDE DIAMETER          [mm]    B\tab =',F10.2,/                  1
'\par FLANGE OUTSIDE DIAMETER         [mm]    A\tab =',F10.2,/                  1
'\par FLANGE THICKNESS                [mm]    t\tab =',F10.2,/                  1
'\par HUB MINIMUM THICKNESS           [mm]    g{\sub 0}\tab =',F10.2,/          1
'\par HUB MAXIMUM THICKNESS           [mm]    g{\sub 1}\tab =',F10.2,/          1
'\par HUB LENGTH                      [mm]    h\tab =',F10.2,/                  1
'\par FLANGE ELASTIC MODULUS         [MPa]    E\tab =',F10.0,/                  1
'\par BOLTS  ELASTIC MODULUS         [MPa]    E\tab =',F10.0,/                  1
'\par POISSON''S RATIO                 [--]    ',/                              1
'{{\field{\*\fldinst SYMBOL 110 \\f "Symbol" \\s 9}{\fldrslt\f1\fs18}}}',       1
'\tab = 0.3\par TARGET BOLT LOAD UNDER PRESS.  [N]     W{\sub m}\tab =',F10.0/  1
'\par FLANGE MOMENT UNDER PRESS.     [N.mm]   M{\sub 1}\tab =',E10.5)           1
stop4                                                                           1
            ('\par \pard \s18\qj\widctlpar\tx2977 '                             1
'\par W{\sub 0}=2M{\sub 1}/(A-B)\tab =',E12.7/                                  1
'\par g{\sub 1}/g{\sub 0}\tab =',F9.3/                                          1
'\par h{\sub 0}='/                                                              1
'{{\field{\*\fldinst SYMBOL 214 \\f "Symbol" \\s 9}{\fldrslt\f1\fs18}}}'/       1
'(B*g{\sub 0})\tab =',F9.3/                                                     1
'\par h/h{\sub 0}\tab =',F9.3/                                                  1
'\par F\tab =',F9.3,' (from FIG.12.20)',/,                                      1
'\par V\tab =',F9.3,' (from FIG.12.20)\par ')                                   1
stop5                                                                           1
            ('\par ',5X,                                                        1
    '\par            (K^2)-1              B*psi             W1',/,              1
    '\par  A1  = --------------- * -------------------- * ------ *',/,          1
    '\par        (1+v)             (1+alpha)^3*E*go*h^2   4*3.14',/,            1
    '\par        ----- *(K^2)+1',/,                                             1
    '\par        (1-v)',/,                                                      1
    '\par                        1+v      K^2',/,                               1
    '\par                 0.5+( ----- )*( ----- )*lnK',/,                       1
    '\par                        1-v      K^2-1',/,                             1
    '\par      * --------------------------------------------  =',F12.6         1
      ,/,                                                                       1
    '\par                t/go      (1+v)*(K^2-1)*(t/go)^3',/,                   1
    '\par            1+-------*F + ----------------------- * V',/,              1
    '\par              SQR(B/go)               1+v',/,                          1
    '\par                          SQR(B/go)*(-----*K^2+1)',/,                  1
    '\par                                      1-v',//,5X,                      1
      'Slope of the middle surface at the inner edge of the ring,theta:'        1
      ,/,                                                                       1
    '\par                 B      3*(1-v^2)',/,                                  1
    '\par theta= A1*  --------*[-----------]^0.25*(1+v)^3 * V  =',F12.6         1
      ,' (rad)',/,                                                              1
    '\par               2*h         psi',/,                                     1
    '\par                                                      =',F12.6         1
      ,' (deg)',/,                                                              1
    '\par NOTE: A1 from formula (12.56),theta from formula (12.54)')            1
stop6                                                                           1
('\par \pard \s18\qj\widctlpar\tx5245 ',                                        1  
