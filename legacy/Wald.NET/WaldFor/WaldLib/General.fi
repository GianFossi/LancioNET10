      COMMON/OPTION/BINAR(100,100),KIJ,IEQ,IM,ISUP,KCRT,KWRT,VL,IOPT1,
     *       ISETK
      REAL BINAR,VL,KAPPA(100,100)
	INTEGER*2 KIJ,IEQ,IM,ISUP,KCRT,KWRT,IOPT1,KEQ,ISETK
	EQUIVALENCE(BINAR(1,1),KAPPA(1,1)),(IEQ,KEQ)
      COMMON/BANK1/M(100),TC(100),PC(100),ZC(100),OMEGA(100),BP(100)
	REAL M,TC,PC,ZC,OMEGA,BP,W(100)
	EQUIVALENCE(M(1),W(1))
      COMMON/NCODEX/NCOD(100),NAME(100,5),NCST,NCNST,NCIP,NC,NCW
      INTEGER*2 NCOD,NCST,NCNST,NCIP,NC,NCW
	CHARACTER*4 NAME
      COMMON/COEFS/AI(100),BI(100),CI(100),DI(100),EI(100)
	REAL AI,BI,CI,DI,EI
      COMMON/BANK2/ZRA(100),SPG(100),TD(100),PD(100)
	REAL ZRA,SPG,TD,PD
      COMMON/COEFH/A(100),B(100),C(100),D(100),E(100)
	REAL A,B,C,D,E
      COMMON/SYSTEM/IN,IO,KDOS,MDOS,LDOS,NDOS,NUOVER,NOUTP3,KCONV,IDEBUG
     1   ,NSTOP,INDH2,ITER,IHOL,KIDL,K006,KIN,KPAD,AKK
      INTEGER *2 IN,IO,KDOS,MDOS,LDOS,NDOS,NUOVER,NOUTP3,KCONV,IDEBUG,
     1   NSTOP,INDH2,ITER,IHOL,KIDL,K006,K003,K004,K005,KIN,KPAD
	REAL AKK(6) 
	EQUIVALENCE(ITER,K003),(IHOL,K004),(KIDL,K005)
	COMMON/INDEX/KBDF,KE,KU,KHS,KW
	INTEGER*2 KBDF,KE,KU,KHS,KW
      COMMON/TEMPRE/TINP,PINP,T,P
	REAL TINP,PINP,T,P,T0,P0
	EQUIVALENCE (TINP,T0),(PINP,P0)
      COMMON/COTENS/PARAK(100),TENS
	REAL PARAK,TENS
      COMMON/COVISG/SIGMA(100),EPSUK(100),DELTA(100),VISG
	REAL SIGMA,EPSUK,DELTA,VISG
      COMMON/COVISL/VVB(100),VVT0(100),VISL
	REAL VVB,VVT0,VISL
      COMMON/COTERG/A1CON(100),A2CON(100),A3CON(100),TERG
	REAL A1CON,A2CON,A3CON,TERG,AKGAS
	EQUIVALENCE(TERG,AKGAS)
      COMMON/COTERL/AH(100),DELH(100),TERL
      REAL AH,DELH,TERL,AKLIQ
	EQUIVALENCE(TERL,AKLIQ)