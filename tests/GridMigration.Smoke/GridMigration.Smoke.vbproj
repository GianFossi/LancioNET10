<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms><EnableWindowsTargeting>true</EnableWindowsTargeting>
    <PlatformTarget>x86</PlatformTarget><RuntimeIdentifier>win-x86</RuntimeIdentifier><OptionStrict>On</OptionStrict>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../../src/Migration/LegacyGridView.vb" Link="LegacyGridView.vb" />
    <ProjectReference Include="../../src/Lancion/Lancion.vbproj" />
  </ItemGroup>
</Project>
