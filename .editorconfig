root = true

[*]
charset = utf-8
insert_final_newline = true
indent_style = space
indent_size = 4

[*.{md,yml,yaml,json}]
indent_size = 2

# Non eseguire una normalizzazione massiva dei sorgenti legacy.
# Verificare prima encoding e terminatori originali durante l'importazione.

# VS2003 VB WithEvents creates properties whose field attributes are not forwarded.
# Keep this designer diagnostic visible while migrating initialization by hand.
[src/RoutBase/*.vb]
dotnet_diagnostic.WFO1000.severity = warning

# Manually initialized VB WithEvents properties; same temporary designer policy as RoutBase.
[src/LibMat/*.vb]
dotnet_diagnostic.WFO1000.severity = warning

# The remaining migrated VB forms use the same manual-initialization designer policy.
[src/{Orecchia,Traccia,Saddles,Tiranti,Grafic2,Wrcb}/*.vb]
dotnet_diagnostic.WFO1000.severity = warning

[src/{AsmeVip,Lancion}/*.vb]
dotnet_diagnostic.WFO1000.severity = warning

[src/DataShDll/*.vb]
dotnet_diagnostic.WFO1000.severity = warning

[src/{Wald,VapAcqua,BreLock}/*.vb]
dotnet_diagnostic.WFO1000.severity = warning

[src/Ppgas/*.vb]
dotnet_diagnostic.WFO1000.severity = warning

[src/{HTRI,Ventil}/*.vb]
dotnet_diagnostic.WFO1000.severity = warning

[src/SurriscDll/*.vb]
dotnet_diagnostic.WFO1000.severity = warning
