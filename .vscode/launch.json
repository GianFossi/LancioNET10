{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Lancion complete VB GUI (Windows x86)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Lancion GUI",
      "program": "${workspaceFolder}/src/Lancion/bin/Debug/net10.0-windows/win-x86/Lancio.exe",
      "cwd": "${workspaceFolder}",
      "env": {
        "LANCIO_INI": "${input:lancioIni}"
      },
      "stopAtEntry": true,
      "justMyCode": false
    },
    {
      "name": "ASME cylinder thickness and pressure (original VB)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build ASME cylinder debugger",
      "program": "${workspaceFolder}/tools/AsmeCalculation.Debug/bin/Debug/net10.0/AsmeCalculation.Debug.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": true,
      "justMyCode": false
    },
    {
      "name": "FormulaParser checks (VB)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build migrated components",
      "program": "${workspaceFolder}/tests/FormulaParser.Smoke/bin/Debug/net10.0-windows/FormulaParser.Smoke.dll",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": false
    },
    {
      "name": "Legacy interpolation step by step (VB, Windows)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build legacy calculation debugger",
      "program": "${workspaceFolder}/tools/LegacyCalculation.Debug/bin/Debug/net10.0-windows/LegacyCalculation.Debug.dll",
      "args": [],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "stopAtEntry": true,
      "justMyCode": false
    }
  ],
  "inputs": [
    {
      "id": "lancioIni",
      "type": "promptString",
      "description": "Percorso assoluto della copia INI configurata per questo PC"
    }
  ]
}
